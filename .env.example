# Copy this file to .env and set real values. NEVER commit .env
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env

# --- Data Warehouse (PostgreSQL) ---
DWH_USER=olist_user
DWH_PASSWORD=change_me
DWH_DB=olist_dwh
# Used by scripts running OUTSIDE Docker (ingestion, Power BI).
# Inside the containers, docker-compose sets host=dwh-db and port=5432.
DWH_HOST=localhost
DWH_PORT=5433
# Port published on your machine (optional, default 5433)
DWH_HOST_PORT=5433

# --- Airflow metadata DB ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# --- Airflow web UI admin ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_UID=50000
